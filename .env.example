NEXT_PUBLIC_SITE_URL=https://sungandi86-max.github.io/sungandi-mini-homepage

# GitHub Pages 프로젝트 페이지 하위 경로. 로컬 개발에서는 비워 둡니다.
# NEXT_PUBLIC_BASE_PATH=/sungandi-mini-homepage

# 한줄평(방명록)을 Firestore 에 저장할 때만 필요합니다. 비워 두면 예시 한줄평이 보입니다.
# Firebase 웹 설정값은 비밀키가 아니며 배포된 JS 에 그대로 들어갑니다.
# 실제 접근 제어는 firestore.rules 가 담당합니다.
# GitHub Pages 배포에서는 같은 값을 Actions 저장소 비밀 설정으로 등록합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# 숫자형 sender ID가 아니라 Firebase 프로젝트 ID 문자열을 입력합니다.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
